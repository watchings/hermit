ARG PYTHON_IMAGE=python:3.12-bookworm
FROM ${PYTHON_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates git proot \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch main --single-branch https://github.com/NousResearch/hermes-agent /opt/hermes-agent \
    && git clone --branch master --single-branch https://github.com/nesquena/hermes-webui /opt/hermes-webui \
    && git -C /opt/hermes-agent rev-parse HEAD > /opt/hermes-agent-revision \
    && git -C /opt/hermes-webui rev-parse HEAD > /opt/hermes-webui-revision

RUN python -c 'import subprocess,tomllib; d=tomllib.load(open("/opt/hermes-agent/pyproject.toml","rb"))["project"]["dependencies"]; subprocess.run(["python","-m","pip","install","--no-cache-dir",*d],check=True)' \
    && python -m pip install --no-cache-dir -r /opt/hermes-webui/requirements.txt

RUN mkdir -p /opt/hermes-python \
    && python --version 2>&1 | tee /opt/hermes-python/python-version \
    && python -m pip freeze --all > /opt/hermes-python/requirements-aarch64.lock \
    && python -m compileall -q /opt/hermes-agent /opt/hermes-webui

WORKDIR /opt
